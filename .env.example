# Настройки бота. Этот файл хранит секреты: никому его не пересылайте.

# Токен бота от @BotFather (длинная строка вида 1234567890:AAE...)
BOT_TOKEN=вставьте_сюда_токен

# Ваш Telegram ID. Бот подскажет его, когда вы напишете ему /start.
# Несколько человек: через запятую, например ADMIN_IDS=111,222
ADMIN_IDS=

# Нейросеть для своих тем (бесплатно, Cloudflare Workers AI). Как получить, написано в INSTALL.md.
# Account ID: 32 символа из цифр и букв a-f. Токен: из шаблона "Workers AI".
CF_ACCOUNT_ID=
CF_API_TOKEN=
